{
  "name": "game-dev",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "check": "npm run lint && npm test",
    "test": "node --test --test-concurrency=4 tests/sessions.test.mjs",
    "lint": "shellcheck -x -P SCRIPTDIR tests/container/stock tests/container/check-stock tests/container/markdown && markdownlint-cli2"
  },
  "devDependencies": {
    "@andornaut/delivery-kit": "https://github.com/andornaut/delivery-kit/releases/download/v3.0.1/delivery-kit-3.0.1.tgz",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "0.24.0",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "markdownlint-cli2@0.24.0": {
      "markdownlint": "0.42.1",
      "katex": "0.19.1"
    }
  }
}
